// v1 data model for the crowdsourced task platform.
// Postgres (Neon in prod; a Neon branch or any local/dev Postgres also works
// for local dev — see README for setup, since Prisma can't target SQLite and
// Postgres from one schema).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TemplateType {
  BOUNDING_BOX
  POINT
  LABELING
  FREEFORM_DRAWING
  VIDEO_RECORDING
  PHOTO_CAPTURE
  SURVEY
  RATING
}

enum ChallengeCategory {
  FUN
  PRETRAINING
}

// Independent of category (fun/pretraining) and template type: is the doer
// marking up data that already exists (LABELING, BOUNDING_BOX, ...), or
// contributing new data (PHOTO_CAPTURE, VIDEO_RECORDING, ...)? Creator-set,
// defaulted from template type but overridable, since e.g. a LABELING
// challenge whose "items" are blank prompts can still be a collection task.
enum ChallengePurpose {
  ANNOTATING
  COLLECTING
}

enum ChallengeStatus {
  ACTIVE
  COMPLETED
  FLAGGED
  REMOVED
}

enum SubmissionStatus {
  APPROVED
  FLAGGED
  REMOVED
}

enum CreditReason {
  SIGNUP_BONUS
  EARN_SUBMISSION
  SPEND_CHALLENGE_POST
  REFUND_UNUSED_ITEMS
  ADMIN_ADJUST
}

enum FlagTargetType {
  CHALLENGE
  SUBMISSION
}

// A visitor's identity. Created anonymously on first visit (device-id cookie);
// username/email/displayName are filled in later if/when they create an
// account (required to post a challenge, never required to do one).
model User {
  id          String   @id @default(cuid())
  anonToken   String   @unique // opaque id stored in an httpOnly cookie
  displayName String?
  credits     Int      @default(20)
  createdAt   DateTime @default(now())

  // "Create an account" (no email verification in v1): username, email and
  // passwordHash are all set together at creation. passwordHash is a scrypt
  // hash (see lib/password.ts) — the plaintext password is never stored.
  // Posting a challenge requires all three to be set — doing challenges
  // never does. Accounts created purely via Google sign-in (no password set
  // at creation) leave this null — they sign in via Google only.
  username     String? @unique
  email        String? @unique
  passwordHash String?

  // Real first/last name, collected at account creation (and from existing
  // accounts via NameGate) for admin review only — never returned by any
  // non-admin query (see getAccountStatus, which exposes just whether
  // they're set).
  firstName String?
  lastName  String?

  // "Continue with Google" — an alternative to the recovery-code flow above.
  // googleId is the token's stable `sub` claim; email is shared with the
  // field above (whichever path created the account first "owns" that
  // email — Google sign-in on a matching email links to it rather than
  // erroring, since Google has already verified that email for us).
  googleId String? @unique

  // Profile photo shown in the nav and account settings — an uploaded image
  // (served from /api/uploads/image, same as challenge item images), not a
  // Google avatar; a viewer with no account/no upload falls back to initials.
  avatarUrl String?

  // Account-based admin — grants the same moderation/posting privileges as
  // the shared ADMIN_PASSWORD cookie (see lib/admin.ts's isAdmin(), which
  // checks both), but tied to one person's account instead of one secret
  // everyone shares. Requires a full account (username/email) since it's
  // granted by username, see grantAdminAction in app/admin/actions.ts.
  isAdmin Boolean @default(false)

  // Set by an admin from /admin/users/[id]. Applies to the underlying device
  // identity (the row), account or not, and is enforced server-side on
  // every write path (see getActiveUser in lib/identity.ts) plus a
  // full-page BanGate. banReason is shown to the banned user.
  isBanned  Boolean   @default(false)
  bannedAt  DateTime?
  banReason String?

  // Self-attested age/ToS gate, shown once before first use of the app.
  ageAttested Boolean @default(false)

  challenges  Challenge[]
  submissions Submission[]
  transactions CreditTransaction[]
  flags       Flag[]
}

// A posted challenge: a template type + creator-supplied config, applied over
// one or more items, each of which needs `targetResponsesPerItem` submissions.
model Challenge {
  id                     String            @id @default(cuid())
  creatorId              String
  creator                User              @relation(fields: [creatorId], references: [id])
  templateType           TemplateType
  category               ChallengeCategory @default(FUN)
  purpose                ChallengePurpose  @default(ANNOTATING)
  prompt                 String // instruction shown to the doer, e.g. "draw a box around the cat"
  config                 String // JSON blob, shape depends on templateType (see lib/templates)
  timeLimitSeconds       Int               @default(30)
  targetResponsesPerItem Int               @default(10)
  status                 ChallengeStatus   @default(ACTIVE)
  createdAt              DateTime          @default(now())

  items       ChallengeItem[]
  submissions Submission[]
  flags       Flag[]

  @@index([status, templateType])
}

// One presentable unit within a challenge (one image to box, one snippet to label, ...).
// Simple single-prompt challenges (no media set) still get exactly one auto-created item.
model ChallengeItem {
  id            String   @id @default(cuid())
  challengeId   String
  challenge     Challenge @relation(fields: [challengeId], references: [id])
  order         Int       @default(0)
  mediaUrl      String?
  textContent   String?
  responseCount Int       @default(0) // denormalized, incremented per submission

  submissions Submission[]

  @@index([challengeId])
}

// One doer's answer to one item.
model Submission {
  id            String           @id @default(cuid())
  challengeId   String
  challenge     Challenge        @relation(fields: [challengeId], references: [id])
  itemId        String
  item          ChallengeItem    @relation(fields: [itemId], references: [id])
  submitterId   String
  submitter     User             @relation(fields: [submitterId], references: [id])
  answer        String // JSON blob, shape depends on Challenge.templateType (see lib/templates)
  status        SubmissionStatus @default(APPROVED)
  timeTakenMs   Int
  createdAt     DateTime         @default(now())

  flags Flag[]

  @@unique([itemId, submitterId]) // one answer per doer per item
  @@index([challengeId])
}

// Append-only ledger; User.credits is a denormalized running balance kept in sync with this.
model CreditTransaction {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  amount             Int // positive = earn, negative = spend
  reason             CreditReason
  relatedChallengeId String?
  createdAt          DateTime     @default(now())

  @@index([userId])
}

// Moderation report on a challenge or submission. Present from day one per spec,
// even though v1 review tooling is minimal (see /admin).
model Flag {
  id           String         @id @default(cuid())
  targetType   FlagTargetType
  challengeId  String?
  challenge    Challenge?     @relation(fields: [challengeId], references: [id])
  submissionId String?
  submission   Submission?    @relation(fields: [submissionId], references: [id])
  reporterId   String
  reporter     User           @relation(fields: [reporterId], references: [id])
  reason       String
  resolved     Boolean        @default(false)
  createdAt    DateTime       @default(now())

  @@index([resolved])
}
